# Settings for the VIO chain on the plane (setup/run_vio_d455.sh, also when started by the vio.service).
# setup/jetson_install.sh copies this to setup/vio.env - edit that one.

# the flight controller link: the Jetson's UART on the 40-pin header (pins 8 TX, 10 RX), 921600 baud
# (on the flight controller: SERIALx_PROTOCOL 2, SERIALx_BAUD 921 for the port it is wired to)
MAVLINK=/dev/ttyTHS0,921600

# where the camera sits relative to the flight controller: FORWARD,RIGHT,DOWN in metres (measure it)
LEVER=0,0,0

# 1280x800 (the whole sensor - best in the simulator's tests) or 848x480
RES=1280x800

# 1 = also record camera + IMU for replaying flights later (about 1 GB a minute - watch the free space)
RECORD=0
